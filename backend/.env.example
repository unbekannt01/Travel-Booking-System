# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/yatrahub
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Cryptographic Keys (MUST be at least 32 characters long in production)
# Generate each using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
TOTP_ENC_KEY=replace_with_a_secure_random_string_of_at_least_32_characters
DATA_ENC_KEY=replace_with_a_secure_random_string_of_at_least_32_characters

# Email / SMTP Credentials (Optional - for 2FA recovery and password reset)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
