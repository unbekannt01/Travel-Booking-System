# Server Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/yatrahub
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Cryptographic Keys (MUST be at least 32 characters long in production)
# Generate each using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<32-characters-keys>
TOTP_ENC_KEY=<32-characters-keys>
DATA_ENC_KEY=<32-characters-keys>

# Email / SMTP Credentials (Optional - for 2FA recovery and password reset)
EMAIL_SERVICE=gmail
EMAIL_USER=abc@gmail.com
EMAIL_PASS=xxxxxxxxxxx
